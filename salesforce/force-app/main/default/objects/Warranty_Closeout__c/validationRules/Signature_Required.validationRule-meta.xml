<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Signature_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), OR(NOT(Signature_Confirmed__c), ISBLANK(Signature_Checked_At__c)))</errorConditionFormula>
    <errorMessage>Record the technician attestation before creating a closeout.</errorMessage>
</ValidationRule>
